{
  "name": "meghsurae-ai-manager",
  "version": "1.0.0",
  "private": true,
  "description": "AI-assisted YouTube channel manager for @MEGHSURAE with approval-gated writes and an MCP endpoint",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:push:pg": "prisma db push --schema prisma/schema.postgres.prisma",
    "db:generate:pg": "prisma generate --schema prisma/schema.postgres.prisma",
    "db:studio": "prisma studio",
    "gen:secrets": "node scripts/gen-secrets.mjs",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:pg": "prisma migrate deploy --schema prisma/postgresql/schema.prisma"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "zod": "4.6.7",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.23",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
