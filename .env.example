# Copy to .env and fill in. NEVER commit .env.

# SQLite (local). Apply checked-in migrations with: npm run db:migrate
DATABASE_URL="file:./dev.db"

# Public base URL of this app (no trailing slash). Must match the Google redirect URI host.
APP_URL="http://localhost:3000"

# Google Cloud OAuth 2.0 Web client (see README)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# 32+ random characters. Encrypts stored Google tokens. Generate: npm run gen:secrets
TOKEN_ENCRYPTION_KEY="replace-with-generated-secret-at-least-32-chars"

# Optional but recommended: only this Google account may sign in
ALLOWED_EMAIL=""

# Optional bootstrap/admin secret for /api/mcp and /api/mcp/token. 24+ random characters.
# Prefer issuing short-lived per-client credentials via POST /api/mcp/token.
MCP_AUTH_TOKEN=""

# Optional AI providers (app works without either, using built-in heuristics)
# Anthropic API is a paid service. Gemini has a free tier with limits.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-5-5"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Optional: allow a client without headers to use /api/mcp/<MCP_AUTH_TOKEN> once.
# The URL credential is consumed on first request but may leak in logs/history; prefer headers.
MCP_ALLOW_URL_TOKEN=""
